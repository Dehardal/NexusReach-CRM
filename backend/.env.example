# ==========================================
# CRM Backend Environment Configuration
# ==========================================

# Server Port & Environment
PORT=12000
NODE_ENV=development

# JWT Authentication Secret Key (REQUIRED: Change this in production!)
JWT_SECRET=your_super_secret_jwt_key_here_change_me_in_production

# Master Architect Google Identity (Granted full unrestricted system ownership)
MASTER_EMAIL=admin@example.com

# Google OAuth 2.0 Client ID (Optional: For Google 1-Click Sign-In button)
GOOGLE_CLIENT_ID=

# MongoDB Database Connection String
# Local MongoDB (default):
MONGO_URI=mongodb://127.0.0.1:27017/new_crm
# Or MongoDB Atlas Cloud:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/new_crm?retryWrites=true&w=majority

# Default Outbound SMTP Email Configuration (Nodemailer)
EMAIL_USER=your_smtp_user@example.com
EMAIL_PASS=your_smtp_password_or_app_password
NOTIFICATION_EMAIL=alerts@example.com

# Hostinger Agentic Mail API Configuration (Optional)
# Obtain from Hostinger hPanel -> Emails -> Agentic Mail -> API Access
HOSTINGER_MAIL_API_KEY=your_hostinger_mail_api_key_here
HOSTINGER_DOMAIN=yourdomain.com

# AI Integration Options (Optional)
# 1. HuggingFace Free Inference Token (https://huggingface.co/settings/tokens)
HUGGING_FACE_TOKEN=
# 2. Local Ollama LLM endpoint (default: http://localhost:11434/api/generate)
OLLAMA_URL=http://localhost:11434/api/generate
RUN_OLLAMA=false
